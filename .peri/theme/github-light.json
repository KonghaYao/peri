{
  "name": "github-light",
  "mode": "light",
  "palette": {
    "base": {
      "bg": "#F6F8FA",
      "fg": "$semantic.text.primary"
    },
    "brand": {
      "primary": "$semantic.accent"
    },
    "gray": {
      "bright": "$semantic.text.primary",
      "muted": "$semantic.text.muted",
      "dim": "$semantic.text.dim",
      "dark": "$semantic.border.dim"
    },
    "accent": {
      "primary": "$semantic.accent"
    },
    "success": {
      "primary": "#1A7F37"
    },
    "warning": {
      "primary": "#9A6700"
    },
    "danger": {
      "primary": "#CF222E"
    },
    "info": {
      "primary": "$semantic.thinking"
    },
    "diff": {
      "add": "#1A7F37",
      "remove": "#CF222E",
      "hunk": "#8250DF",
      "add_bg": "#DAFBE1",
      "remove_bg": "#FFEBE9",
      "add_word_bg": "#ACEFB2",
      "remove_word_bg": "#FFC0B8"
    }
  },
  "semantic": {
    "accent": "#0969DA",
    "text": {
      "primary": "#626569",
      "muted": "#656D76",
      "dim": "#878F99"
    },
    "border": {
      "default": "#959DA6",
      "active": "$semantic.accent",
      "dim": "#D0D7DE"
    },
    "status": {
      "running": "#8250DF",
      "success": "#1A7F37",
      "warning": "#9A6700",
      "error": "#CF222E"
    },
    "surface": {
      "default": "#F6F8FA",
      "user": "#E1E6ED",
      "popup": "#FFFFFF",
      "selection": "#C4D4EE",
      "cursor": "#E1E6ED"
    },
    "diff": {
      "add": "#1A7F37",
      "remove": "#CF222E",
      "hunk": "#8250DF",
      "add_bg": "#DAFBE1",
      "remove_bg": "#FFEBE9",
      "add_word_bg": "#ACEFB2",
      "remove_word_bg": "#FFC0B8"
    },
    "loading": "#8250DF",
    "thinking": "#8250DF",
    "model_info": "#BF3989",
    "bash_border": "#CF222E",
    "selected_fg": "#0D1117"
  },
  "component": {
    "message": {
      "user_bg": "#E1E6ED",
      "ai_prefix": "$semantic.text.primary",
      "tool_indicator": "#1A7F37",
      "reasoning": "$semantic.thinking"
    },
    "input": {
      "border": "$semantic.text.muted",
      "border_loading": "$semantic.text.muted",
      "cursor_fg": "#FFFFFF",
      "cursor_bg": "#1F2328",
      "prompt": "$semantic.text.muted",
      "prompt_loading": "$semantic.text.muted",
      "continuation": "$semantic.text.dim",
      "placeholder": "$semantic.text.muted"
    },
    "panel": {
      "border": "$semantic.accent",
      "title": "$semantic.text.primary",
      "row_selected": "$semantic.selected_fg",
      "min_height": "8",
      "max_height": "28"
    },
    "popup": {
      "bg": "#FFFFFF",
      "border": "$semantic.thinking",
      "action_primary": "$semantic.accent",
      "selected_fg": "$semantic.selected_fg",
      "modal_max_width": "90",
      "modal_max_height": "28",
      "inline_height": "10"
    },
    "statusbar": {
      "text": "$semantic.text.primary",
      "muted": "$semantic.text.muted",
      "dim": "$semantic.text.dim",
      "mode_accept_edit": "$semantic.thinking",
      "mode_auto": "#9A6700",
      "mode_bypass": "#CF222E",
      "resource_good": "#1A7F37",
      "resource_warn": "#9A6700",
      "resource_bad": "#CF222E"
    },
    "markdown": {
      "text": "$semantic.text.primary",
      "code": "#0550AE",
      "quote": "$semantic.text.muted"
    },
    "scrollbar": {
      "thumb": "$semantic.text.muted",
      "track": "$semantic.text.dim"
    }
  }
}
