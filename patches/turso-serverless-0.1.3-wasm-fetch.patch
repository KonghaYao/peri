+//! HTTP transport seam.
+//!
+//! Every driver call is a single POST to a stream endpoint. This module owns
+//! the request/response shape and the executor that performs the request. The
+//! default executor is `reqwest`; builds that enable `wasm-fetch` perform the
+//! same requests through the host's `fetch` instead (browser hosts have no
+//! POSIX sockets), keeping the wire protocol and error shape unchanged.
+
+use std::pin::Pin;
+use std::sync::Arc;
+
+use bytes::Bytes;
+use futures::{future::BoxFuture, Stream};
+
+use crate::{Error, Result};
+
+/// One driver request: a POST with the driver's headers and JSON body.
+pub struct HttpRequest {
+    pub url: String,
+    pub headers: Vec<(String, String)>,
+    pub body: Vec<u8>,
+}
+
+/// A response body as a byte stream. Cursor responses are newline-delimited
+/// JSON and are decoded incrementally; the other endpoints read the stream to
+/// the end.
+pub type HttpResponseBody = Pin<Box<dyn Stream<Item = Result<Bytes>> + Send>>;
+
+/// A driver response: the status code and the body stream.
+pub struct HttpResponse {
+    pub status: u16,
+    pub body: HttpResponseBody,
+}
+
+/// Performs driver HTTP requests.
+///
+/// The future returned by `execute` is `Send` on every target: host work that
+/// is not `Send` (browser `fetch` handles) stays on the JS microtask queue and
+/// reaches the caller through channels, so the store keeps its thread-safe
+/// contract even when the network primitive is the host's `fetch`.
+pub trait HttpExecutor: Send + Sync + 'static {
+    fn execute(&self, request: HttpRequest) -> BoxFuture<'static, Result<HttpResponse>>;
+}
+
+/// The executor used when the caller does not inject one.
+pub fn default_executor() -> Arc<dyn HttpExecutor> {
+    #[cfg(all(target_os = "emscripten", feature = "wasm-fetch"))]
+    {
+        Arc::new(fetch::FetchExecutor)
+    }
+    #[cfg(not(all(target_os = "emscripten", feature = "wasm-fetch")))]
+    {
+        Arc::new(reqwest_executor::ReqwestExecutor::new())
+    }
+}
+
+#[cfg(not(all(target_os = "emscripten", feature = "wasm-fetch")))]
+mod reqwest_executor {
+    use super::*;
+    use futures::StreamExt;
+
+    pub(super) struct ReqwestExecutor {
+        client: reqwest::Client,
+    }
+
+    impl ReqwestExecutor {
+        pub(super) fn new() -> Self {
+            Self {
+                client: reqwest::Client::new(),
+            }
+        }
+    }
+
+    impl HttpExecutor for ReqwestExecutor {
+        fn execute(&self, request: HttpRequest) -> BoxFuture<'static, Result<HttpResponse>> {
+            let client = self.client.clone();
+            Box::pin(async move {
+                let mut builder = client.post(&request.url);
+                for (name, value) in &request.headers {
+                    builder = builder.header(name.as_str(), value.as_str());
+                }
+                let response = builder
+                    .body(request.body)
+                    .send()
+                    .await
+                    .map_err(|error| {
+                        Error::Http(format!("request to {} failed: {error}", request.url))
+                    })?;
+                let status = response.status().as_u16();
+                let stream = response.bytes_stream().map(|chunk| {
+                    chunk.map_err(|error| {
+                        Error::Http(format!("response body stream failed: {error}"))
+                    })
+                });
+                Ok(HttpResponse {
+                    status,
+                    body: Box::pin(stream),
+                })
+            })
+        }
+    }
+}
+
+#[cfg(all(target_os = "emscripten", feature = "wasm-fetch"))]
+mod fetch {
+    use super::*;
+    use js_sys::{Promise, Reflect, Uint8Array};
+    use tokio::sync::{mpsc, oneshot};
+    use wasm_bindgen::prelude::*;
+    use wasm_bindgen_futures::{spawn_local, JsFuture};
+
+    const QUEUED_CHUNKS: usize = 2;
+
+    #[wasm_bindgen(inline_js = r#"
+export function periStoreFetchBegin(url, headersJson, body) {
+    const handle = { controller: new AbortController(), reader: null };
+    handle.response = globalThis.fetch(url, {
+        method: 'POST',
+        headers: JSON.parse(headersJson),
+        body,
+        signal: handle.controller.signal,
+        redirect: 'manual',
+    });
+    return handle;
+}
+export function periStoreFetchResponse(handle) { return handle.response; }
+export function periStoreFetchStatus(response) { return response.status; }
+export function periStoreFetchRead(handle, response) {
+    if (!response.body) return Promise.resolve({ done: true });
+    handle.reader ??= response.body.getReader();
+    return handle.reader.read();
+}
+export function periStoreFetchClose(handle) {
+    handle.controller.abort();
+    const reader = handle.reader;
+    handle.reader = null;
+    if (reader) {
+        try { reader.cancel().catch(() => {}); } catch (_) {}
+    }
+}
+"#)]
+    extern "C" {
+        #[wasm_bindgen(js_name = periStoreFetchBegin, catch)]
+        fn fetch_begin(
+            url: &str,
+            headers_json: &str,
+            body: &JsValue,
+        ) -> std::result::Result<JsValue, JsValue>;
+        #[wasm_bindgen(js_name = periStoreFetchResponse)]
+        fn fetch_response(handle: &JsValue) -> Promise;
+        #[wasm_bindgen(js_name = periStoreFetchStatus, catch)]
+        fn fetch_status(response: &JsValue) -> std::result::Result<f64, JsValue>;
+        #[wasm_bindgen(js_name = periStoreFetchRead, catch)]
+        fn fetch_read(
+            handle: &JsValue,
+            response: &JsValue,
+        ) -> std::result::Result<Promise, JsValue>;
+        #[wasm_bindgen(js_name = periStoreFetchClose)]
+        fn fetch_close(handle: &JsValue);
+    }
+
+    fn describe(error: &JsValue) -> String {
+        error
+            .as_string()
+            .or_else(|| {
+                Reflect::get(error, &JsValue::from_str("message"))
+                    .ok()
+                    .and_then(|value| value.as_string())
+            })
+            .unwrap_or_else(|| format!("{error:?}"))
+    }
+
+    fn failure(url: &str, error: &JsValue) -> Error {
+        Error::Http(format!("request to {url} failed: {}", describe(error)))
+    }
+
+    /// Owns the pump's stop signal: dropping the body stream (or the session
+    /// before it ever gets one) cancels the request instead of letting it keep
+    /// downloading into a channel nobody reads.
+    struct FetchOwnership(Option<oneshot::Sender<()>>);
+
+    impl Drop for FetchOwnership {
+        fn drop(&mut self) {
+            if let Some(sender) = self.0.take() {
+                let _ = sender.send(());
+            }
+        }
+    }
+
+    /// The stream handed to the session. It only carries channel halves, so it
+    /// stays `Send`; the JS handle lives inside the pump task.
+    struct FetchBody {
+        receiver: mpsc::Receiver<Result<Vec<u8>>>,
+        _ownership: FetchOwnership,
+    }
+
+    impl Stream for FetchBody {
+        type Item = Result<Bytes>;
+
+        fn poll_next(
+            mut self: Pin<&mut Self>,
+            context: &mut std::task::Context<'_>,
+        ) -> std::task::Poll<Option<Self::Item>> {
+            self.receiver
+                .poll_recv(context)
+                .map(|option| option.map(|item| item.map(Bytes::from)))
+        }
+    }
+
+    /// Runs `operation` unless the stop signal fires first (the caller dropped
+    /// the stream, so nobody waits for the body any more).
+    async fn until_stopped<F: std::future::Future>(
+        stop: &mut oneshot::Receiver<()>,
+        operation: F,
+    ) -> Option<F::Output> {
+        match futures::future::select(stop, Box::pin(operation)).await {
+            futures::future::Either::Left(_) => None,
+            futures::future::Either::Right((output, _)) => Some(output),
+        }
+    }
+
+    async fn read_chunk(handle: &JsValue, response: &JsValue) -> Result<Option<Vec<u8>>> {
+        let promise = fetch_read(handle, response)
+            .map_err(|error| Error::Http(format!("response body stream failed: {}", describe(&error))))?;
+        let value = JsFuture::from(promise)
+            .await
+            .map_err(|error| Error::Http(format!("response body stream failed: {}", describe(&error))))?;
+        let done = Reflect::get(&value, &JsValue::from_str("done"))
+            .ok()
+            .and_then(|value| value.as_bool())
+            .unwrap_or(false);
+        if done {
+            return Ok(None);
+        }
+        let chunk = Reflect::get(&value, &JsValue::from_str("value"))
+            .map_err(|error| Error::Http(format!("response body stream failed: {}", describe(&error))))?;
+        Ok(Some(Uint8Array::new(&chunk).to_vec()))
+    }
+
+    /// Drives one request on the JS microtask queue: the status is delivered
+    /// once, then the body streams into the chunk channel. The pump owns the JS
+    /// handle and aborts the request when the stop signal fires.
+    async fn pump(
+        url: String,
+        headers_json: String,
+        body: Vec<u8>,
+        mut stop: oneshot::Receiver<()>,
+        status_sender: oneshot::Sender<Result<u16>>,
+        chunks: mpsc::Sender<Result<Vec<u8>>>,
+    ) {
+        let encoded_body: JsValue = Uint8Array::from(body.as_slice()).into();
+        let handle = match fetch_begin(&url, &headers_json, &encoded_body) {
+            Ok(handle) => handle,
+            Err(error) => {
+                let _ = status_sender.send(Err(failure(&url, &error)));
+                return;
+            }
+        };
+        let response = match until_stopped(&mut stop, JsFuture::from(fetch_response(&handle))).await
+        {
+            None => {
+                fetch_close(&handle);
+                return;
+            }
+            Some(Err(error)) => {
+                let _ = status_sender.send(Err(failure(&url, &error)));
+                return;
+            }
+            Some(Ok(response)) => response,
+        };
+        let status = match fetch_status(&response) {
+            Ok(status) if status.fract() == 0.0 && (100.0..=599.0).contains(&status) => status as u16,
+            Ok(status) => {
+                let _ = status_sender.send(Err(Error::Http(format!(
+                    "invalid fetch response status {status} from {url}"
+                ))));
+                fetch_close(&handle);
+                return;
+            }
+            Err(error) => {
+                let _ = status_sender.send(Err(failure(&url, &error)));
+                fetch_close(&handle);
+                return;
+            }
+        };
+        if status_sender.send(Ok(status)).is_err() {
+            // The session stopped waiting for the response.
+            fetch_close(&handle);
+            return;
+        }
+        loop {
+            match until_stopped(&mut stop, read_chunk(&handle, &response)).await {
+                None => {
+                    fetch_close(&handle);
+                    return;
+                }
+                Some(Ok(Some(chunk))) => {
+                    if chunks.send(Ok(chunk)).await.is_err() {
+                        fetch_close(&handle);
+                        return;
+                    }
+                }
+                Some(Ok(None)) => return,
+                Some(Err(error)) => {
+                    let _ = chunks.send(Err(error)).await;
+                    return;
+                }
+            }
+        }
+    }
+
+    pub(super) struct FetchExecutor;
+
+    impl HttpExecutor for FetchExecutor {
+        fn execute(&self, request: HttpRequest) -> BoxFuture<'static, Result<HttpResponse>> {
+            Box::pin(async move {
+                let headers_json = serde_json::to_string(&request.headers).map_err(|error| {
+                    Error::Http(format!("failed to encode request headers: {error}"))
+                })?;
+                let (stop_sender, stop_receiver) = oneshot::channel();
+                let (status_sender, status_receiver) = oneshot::channel();
+                let (chunk_sender, chunk_receiver) = mpsc::channel(QUEUED_CHUNKS);
+                spawn_local(pump(
+                    request.url,
+                    headers_json,
+                    request.body,
+                    stop_receiver,
+                    status_sender,
+                    chunk_sender,
+                ));
+                let status = status_receiver.await.map_err(|_| {
+                    Error::Http(
+                        "the request was cancelled before a response arrived".to_string(),
+                    )
+                })??;
+                Ok(HttpResponse {
+                    status,
+                    body: Box::pin(FetchBody {
+                        receiver: chunk_receiver,
+                        _ownership: FetchOwnership(Some(stop_sender)),
+                    }),
+                })
+            })
+        }
+    }
+}
