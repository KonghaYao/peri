{
  "name": "peri-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "peri-sandbox": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "scripts/patch-sdk.mjs",
    "examples",
    "COMPATIBILITY.md"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-sdk.mjs",
    "prepack": "npm run build",
    "build": "rm -rf dist && tsc",
    "test": "node --test dist/tests/*.test.js",
    "test:mac": "node dist/tests/integration/mac.js",
    "test:mac:programmatic": "node dist/tests/integration/programmatic-mac.js",
    "check": "tsc --noEmit",
    "format": "bunx biome format --write src tests scripts examples package.json tsconfig.json biome.json",
    "format:check": "bunx biome format src tests scripts examples package.json tsconfig.json biome.json"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "better-sqlite3": "^12.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
