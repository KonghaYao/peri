{
  "name": "@peri-code/agent-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run dev:api",
    "dev:api": "bash scripts/api.sh --hot server/main.ts",
    "start": "bash scripts/api.sh server/main.ts",
    "build": "bun run build:server",
    "build:server": "rm -rf dist && bun build server/main.ts --target bun --packages external --outfile dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "format": "biome check --write server shared tests package.json tsconfig.json biome.json",
    "format:check": "biome check server shared tests package.json tsconfig.json biome.json",
    "pack:local": "node scripts/pack-local.mjs"
  },
  "dependencies": {
    "@peri-code/rivet": "file:../peri-rivet",
    "@peri-code/sdk": "file:../@peri-sdk",
    "@tursodatabase/serverless": "1.4.1",
    "hono": "4.13.18",
    "rivetkit": "3.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.6",
    "bun-types": "1.4.4",
    "peri-sandbox": "file:../peri-sandbox",
    "typescript": "7.0.2"
  },
  "bin": {
    "agent-builder": "./bin/agent-builder.js"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "shared",
    "scripts/rivet-engine-wrapper.sh",
    "docs",
    "README.md",
    ".env.example",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.4.3"
  }
}
