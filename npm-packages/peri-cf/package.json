{
  "name": "@peri-code/peri-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peri WASM Agent on a Bun server with a browser client",
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "wasm:profiles": "bun scripts/profile-wasm.ts",
    "prepare:wasm": "bun scripts/prepare-wasm.ts",
    "dev": "bun run prepare:wasm && bun scripts/dev.ts",
    "dev:server": "bun --watch --tsconfig-override server/tsconfig.json server/index.ts",
    "dev:web": "vite",
    "build": "bun run prepare:wasm && vite build",
    "start": "bun --tsconfig-override server/tsconfig.json server/index.ts",
    "preview": "bun --tsconfig-override server/tsconfig.json server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "bun test core frontend scripts && bun test --tsconfig-override server/tsconfig.json server",
    "test:server": "bun test --tsconfig-override server/tsconfig.json server"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.28",
    "@assistant-ui/react-markdown": "^0.14.22",
    "@base-ui/react": "^1.9.0",
    "@legendapp/list": "^3.6.0",
    "@peri-code/sdk": "file:../@peri-sdk",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-shimmer": "^0.4.13",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
