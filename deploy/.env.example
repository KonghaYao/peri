# Compose project name; also prefixes the named volumes.
COMPOSE_PROJECT_NAME=peri-swarm

# PostgreSQL superuser password. Generate with: openssl rand -hex 24
# Keep it URL-safe: it is embedded in both DSNs.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# 宿主 loopback 上暴露 PostgreSQL 的地址和端口，只给 GUI 客户端直连调试用。
# 不想暴露就删掉这两行对应的 compose 端口发布（默认 127.0.0.1:5432）。
POSTGRES_PUBLISH_HOST=127.0.0.1
POSTGRES_PUBLISH_PORT=5432

# Bearer required by every client call to peri-swarm.
# Generate with: openssl rand -hex 32
PERI_SWARM_API_KEY=replace-with-openssl-rand-hex-32

# Rivet admin/node token, shared by rivet-engine, rivet-init and peri-swarm.
# Generate with: openssl rand -hex 32
RIVET_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# nginx 入口在宿主机上的端口和绑定地址。
PERI_SWARM_PORT=8080
PERI_SWARM_PUBLISH_HOST=127.0.0.1

# 每个 peri-swarm 副本的宿主端口范围：Docker 从范围里给每个副本分配一个
# 空闲端口，只用于直连调试；正常流量走 nginx。范围长度要不小于副本数。
PERI_SWARM_REPLICA_PORT_RANGE=8100-8199

# Pin this to the rivetdev/engine build validated against rivetkit 3.1.1.
RIVET_ENGINE_TAG=latest

# --- Observability: OpenObserve ------------------------------------------------
# OpenObserve v1.2.0 tag publishes linux/arm64 and linux/amd64 images.
OPENOBSERVE_TAG=v1.2.0

# Root is used only by openobserve-init to create the two accounts.
# Do not use it for routine work.
# Password policy: 8-128 chars with upper, lower, digit and special character.
# Generate with: printf '%sAa1!' "$(openssl rand -hex 12)"
OPENOBSERVE_ROOT_EMAIL=replace-with-root-email
OPENOBSERVE_ROOT_PASSWORD=replace-with-strong-root-password

# Dedicated account for OTLP ingestion. OSS only supports admin/service_account;
# this account is admin and is not read-only.
OPENOBSERVE_INGEST_EMAIL=peri-swarm-ingest@example.invalid
OPENOBSERVE_INGEST_PASSWORD=replace-with-strong-ingest-password

# Dedicated account for the dashboard's direct queries. It is also admin and
# can write; the dashboard's SELECT-only check is not a security boundary.
OPENOBSERVE_DASHBOARD_EMAIL=peri-swarm-dashboard@example.invalid
OPENOBSERVE_DASHBOARD_PASSWORD=replace-with-strong-dashboard-password

# Basic auth header value for OTLP: base64("ingest-email:ingest-password").
# Generate and keep in sync when the ingest password changes:
#   printf '%s:%s' "$OPENOBSERVE_INGEST_EMAIL" "$OPENOBSERVE_INGEST_PASSWORD" \
#     | base64 | tr -d '\n'
OPENOBSERVE_INGEST_AUTH=replace-with-base64-ingest-email-colon-password

# Keep OpenObserve on loopback (or an internal network); never expose it publicly.
OPENOBSERVE_PUBLISH_HOST=127.0.0.1
OPENOBSERVE_PORT=5080
