+/// Read a response body to the end. Used for responses the driver consumes as
+/// one JSON document (pipeline results and error bodies); cursor responses are
+/// decoded incrementally by [`LineReader`] instead.
+async fn read_body(mut body: HttpResponseBody) -> Result<Vec<u8>> {
+    let mut buffer = Vec::new();
+    while let Some(chunk) = body.next().await {
+        buffer.extend_from_slice(&chunk?);
+    }
+    Ok(buffer)
