{
  "name": "@peri-code/agent-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Network: MCP 2026-07-28 service on Cloudflare Workers, D1 and Durable Objects",
  "scripts": {
    "dev": "wrangler dev --local --port 8792",
    "typecheck": "tsc --noEmit",
    "test:protocol": "bun scripts/verify-protocol.ts",
    "test:acceptance": "bun scripts/acceptance.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:create": "wrangler d1 create peri-agent-network",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "^4.13.13",
    "partyserver": "0.5.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "4.149.0"
  }
}
