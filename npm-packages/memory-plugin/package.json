    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "mcp-use": "2.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
