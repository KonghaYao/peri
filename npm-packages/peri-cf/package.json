{
  "name": "@peri-code/peri-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peri WASM Agent on a Bun server with a browser client",
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "openui:spec": "bun frontend/chat/openui/generate.ts",
    "openui:check": "bun frontend/chat/openui/generate.ts --check",
    "wasm:profiles": "bun scripts/profile-wasm.ts",
    "prepare:wasm": "bun scripts/prepare-wasm.ts",
    "dev": "bun run prepare:wasm && bun scripts/dev.ts",
    "dev:server": "bun --watch --tsconfig-override server/tsconfig.json server/index.ts",
    "dev:web": "vite",
    "build": "bun run openui:check && bun run prepare:wasm && vite build",
    "start": "bun --tsconfig-override server/tsconfig.json server/index.ts",
    "preview": "bun --tsconfig-override server/tsconfig.json server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "bun test frontend scripts && bun test --tsconfig-override server/tsconfig.json server",
    "test:server": "bun test --tsconfig-override server/tsconfig.json server",
    "postinstall": "node node_modules/peri-sandbox/scripts/patch-sdk.mjs"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@legendapp/list": "^3.7.0",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-lang": "1.0.2",
    "@peri-code/sdk": "0.2.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "hono": "4.13.13",
    "lucide-react": "^1.61.0",
    "peri-sandbox": "file:../peri-sandbox",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "2.7.1",
    "tailwind-merge": "^3.7.0",
    "tw-shimmer": "^0.4.14",
    "unstorage": "^1.17.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
