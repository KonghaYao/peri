{
  "name": "@peri/memory-plugin",
  "version": "0.1.0",
  "description": "Peri long-term memory MCP and independent Hindsight message importer",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "memory-plugin": "dist/index.js" },
  "exports": { ".": "./dist/index.js", "./server": "./dist/index.js", "./stdio": "./dist/index.js" },
  "files": ["dist/index.js", "README.md", "DESIGN.md", "VALIDATION.md", "examples"],
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "build": "node scripts/build.mjs",
