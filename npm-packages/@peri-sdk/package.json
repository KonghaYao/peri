{
  "name": "@peri-code/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Peri ACP host SDK with stdio and Emscripten WASM transports",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:workers": "bun examples/workers/build-worker.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.demo.json",
    "test": "bun run build && bun test",
    "dev": "bun run examples/demo/demo.ts",
    "db:dev": "mise exec -- sqld --no-welcome --http-listen-addr 127.0.0.1:8081 --db-path ../../target/peri-sdk-local-turso",
    "demo": "bun run examples/demo/demo.ts",
    "demo:wasm": "bun run examples/demo/demo-wasm.ts",
    "test:wasm": "bun run build && bun test tests/wasm-acp-integration.test.ts tests/wasm-transport.test.ts",
    "smoke:workers": "bun examples/workers/smoke.mjs"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "hono": "^4.6",
    "typescript": "^7.0.0",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "2.0.1",
    "@tursodatabase/serverless": "1.4.0"
  }
}
