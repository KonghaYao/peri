# Compose project name; also prefixes the named volumes.
COMPOSE_PROJECT_NAME=peri-swarm

# PostgreSQL superuser password. Generate with: openssl rand -hex 24
# Keep it URL-safe: it is embedded in both DSNs.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# 宿主 loopback 上暴露 PostgreSQL 的地址和端口，只给 GUI 客户端直连调试用。
# 不想暴露就删掉这两行对应的 compose 端口发布（默认 127.0.0.1:5432）。
POSTGRES_PUBLISH_HOST=127.0.0.1
POSTGRES_PUBLISH_PORT=5432

# Bearer required by every client call to peri-swarm.
# Generate with: openssl rand -hex 32
PERI_SWARM_API_KEY=replace-with-openssl-rand-hex-32

# Rivet admin/node token, shared by rivet-engine, rivet-init and peri-swarm.
# Generate with: openssl rand -hex 32
RIVET_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# nginx 入口在宿主机上的端口和绑定地址。
PERI_SWARM_PORT=8080
PERI_SWARM_PUBLISH_HOST=127.0.0.1

# 每个 peri-swarm 副本的宿主端口范围：Docker 从范围里给每个副本分配一个
# 空闲端口，只用于直连调试；正常流量走 nginx。范围长度要不小于副本数。
PERI_SWARM_REPLICA_PORT_RANGE=8100-8199

# Pin this to the rivetdev/engine build validated against rivetkit 3.1.1.
RIVET_ENGINE_TAG=latest
