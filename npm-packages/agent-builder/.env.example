# 与 README 环境变量表、server/env.ts 一致；只写占位值，不要放真实 token/key。
# HTTP 服务仅允许回环地址，避免把本地配置与 MCP 凭据暴露到局域网。
HOST=127.0.0.1
PORT=3000

# SQLite 配置库。相对进程 cwd 解析；目录会以 0700 创建，数据库及 WAL/SHM 为 0600。
# 父路径任一既有祖先不能含 symlink（不会 realpath 归一化）。
DATABASE_PATH=.data/agent-builder.db

# 唯一显式授权的工作区。相对 cwd 解析为绝对路径；必须是真实目录（不能是 symlink）。
# 启用 Sandbox 时还必须是 0700 私有目录。
PERI_WORKSPACE_ID=agent-builder
PERI_WORKSPACE_PATH=.

# Store 数据库 URL；token 只在服务端使用，空值视为未配置。
PERI_STORE_URL=http://127.0.0.1:8091/db/local_default/agent_builder/main
PERI_STORE_TOKEN=

# 部署只维护一条 Provider，由下列环境变量在启动时同步到私有 SQLite。
# PERI_PROVIDER_TYPE 取 anthropic 或 openai；未设置时不同步。设置后若库里已有多条 Provider，
# 启动会失败而不会删除记录。
# API key 只写入私有 SQLite，不返回 API，也不写入日志；留空表示不配置凭据。
# PERI_PROVIDER_TYPE=openai
# PERI_PROVIDER_BASE_URL=https://api.example.com/v1
# PERI_PROVIDER_API_KEY=
# PERI_PROVIDER_NAME=env

# 内嵌 rivet engine 的本地端口（仅 wasm 模式使用）；同时占用 +1 端口，两个端口都必须空闲。
PERI_ENGINE_PORT=8961
# 可选 UUID；未设置时由数据目录下的 machine-id 文件（0600）生成并保持跨重启稳定。
# 不要临时改这个值：已有 Store 会话归属与 Sandbox URI 都以它为准。
# PERI_MACHINE_ID=

# 引擎数据目录：CLI 默认 <DATABASE_PATH 目录>/rivet 并创建为 0700；
# 直接运行 bun server/main.ts 时必须自行保证目录存在。
RIVETKIT_STORAGE_PATH=.data/rivet

# --- Sandbox（真实 peri-sandbox） ---
# 启用后每个 Chat 在 open 前 acquire 一个 workspace holder，并注入 HTTP MCP。
PERI_SANDBOX_ENABLED=false
# Peri 可执行文件；默认 ~/.peri/peri。需要与 settings 中的 periSha256 一致。
PERI_SANDBOX_PERI_PATH=
# 可选：已有 settings.json（必须 0600）；留空时在 <DATABASE_PATH 目录>/sandbox/settings.json 生成。
PERI_SANDBOX_SETTINGS=
# 可选：Sandbox 实例状态目录；留空时为 <DATABASE_PATH 目录>/sandbox/sandboxes。
PERI_SANDBOX_ROOT=
PERI_SANDBOX_PROFILE=default
# actor 凭据；留空时生成到 <DATABASE_PATH 目录>/sandbox-token（0600）。不要写进日志或提交到仓库。
PERI_SANDBOX_TOKEN=
# 本地 rivetkit spawn engine 的 gateway 凭据，与上面的 actor token 不同；本地默认值不是授权。
PERI_SANDBOX_GATEWAY_TOKEN=default
PERI_SANDBOX_STARTUP_TIMEOUT_MS=90000
PERI_SANDBOX_STOP_TIMEOUT_MS=20000

# 可选的额外 Origin（逗号分隔）。默认允许 http://127.0.0.1:<PORT> 与 localhost 同源。
# PERI_ALLOWED_ORIGINS=
