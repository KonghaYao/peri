{
  "name": "tokyo-night-light",
  "mode": "light",
  "palette": {
    "base": {
      "bg": "#E1E2E7",
      "fg": "$semantic.text.primary"
    },
    "brand": {
      "primary": "$semantic.accent"
    },
    "gray": {
      "bright": "$semantic.text.primary",
      "muted": "$semantic.text.muted",
      "dim": "$semantic.text.dim",
      "dark": "$semantic.border.dim"
    },
    "accent": {
      "primary": "$semantic.accent"
    },
    "success": {
      "primary": "#485E30"
    },
    "warning": {
      "primary": "#8F5E15"
    },
    "danger": {
      "primary": "#8C4351"
    },
    "info": {
      "primary": "$semantic.thinking"
    },
    "diff": {
      "add": "#485E30",
      "remove": "#8C4351",
      "hunk": "#5A4A78",
      "add_bg": "#C8D4B8",
      "remove_bg": "#E0C8CC",
      "add_word_bg": "#B4C4A0",
      "remove_word_bg": "#D4B8BC"
    }
  },
  "semantic": {
    "accent": "#2E6B8C",
    "text": {
      "primary": "#515771",
      "muted": "#5A5F70",
      "dim": "#7C8190"
    },
    "border": {
      "default": "#848996",
      "active": "$semantic.accent",
      "dim": "#D9DBE0"
    },
    "status": {
      "running": "#5A4A78",
      "success": "#485E30",
      "warning": "#8F5E15",
      "error": "#8C4351"
    },
    "surface": {
      "default": "#E1E2E7",
      "user": "#C0C1C8",
      "popup": "#FFFFFF",
      "selection": "#C7D3E8",
      "cursor": "#C0C1C8"
    },
    "diff": {
      "add": "#485E30",
      "remove": "#8C4351",
      "hunk": "#5A4A78",
      "add_bg": "#C8D4B8",
      "remove_bg": "#E0C8CC",
      "add_word_bg": "#B4C4A0",
      "remove_word_bg": "#D4B8BC"
    },
    "loading": "#5A4A78",
    "thinking": "#5A4A78",
    "model_info": "#8C6C3E",
    "bash_border": "#8C4351",
    "selected_fg": "#2A3049"
  },
  "component": {
    "message": {
      "user_bg": "#C0C1C8",
      "ai_prefix": "$semantic.text.primary",
      "tool_indicator": "#485E30",
      "reasoning": "$semantic.thinking"
    },
    "input": {
      "border": "$semantic.text.muted",
      "border_loading": "$semantic.text.muted",
      "cursor_fg": "#E1E2E7",
      "cursor_bg": "#343B59",
      "prompt": "$semantic.text.muted",
      "prompt_loading": "$semantic.text.muted",
      "continuation": "$semantic.text.dim",
      "placeholder": "$semantic.text.muted"
    },
    "panel": {
      "border": "$semantic.accent",
      "title": "$semantic.text.primary",
      "row_selected": "$semantic.selected_fg",
      "min_height": "8",
      "max_height": "28"
    },
    "popup": {
      "bg": "#FFFFFF",
      "border": "$semantic.thinking",
      "action_primary": "$semantic.accent",
      "selected_fg": "$semantic.selected_fg",
      "modal_max_width": "90",
      "modal_max_height": "28",
      "inline_height": "10"
    },
    "statusbar": {
      "text": "$semantic.text.primary",
      "muted": "$semantic.text.muted",
      "dim": "$semantic.text.dim",
      "mode_accept_edit": "$semantic.thinking",
      "mode_auto": "#8F5E15",
      "mode_bypass": "#8C4351",
      "resource_good": "#485E30",
      "resource_warn": "#8F5E15",
      "resource_bad": "#8C4351"
    },
    "markdown": {
      "text": "$semantic.text.primary",
      "code": "#8C6C3E",
      "quote": "$semantic.text.muted"
    },
    "scrollbar": {
      "thumb": "$semantic.text.muted",
      "track": "$semantic.text.dim"
    }
  }
}
