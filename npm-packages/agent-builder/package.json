{
  "name": "@peri-code/agent-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "WEB_PORT=${WEB_PORT:-5173} bash scripts/api.sh --hot server/main.ts",
    "dev:web": "vite",
    "start": "bash scripts/api.sh server/main.ts",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun build server/main.ts --target bun --packages external --outfile dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "bun test",
    "format": "biome check --write src server shared tests package.json tsconfig.json tsconfig.server.json vite.config.ts biome.json components.json",
    "format:check": "biome check src server shared tests package.json tsconfig.json tsconfig.server.json vite.config.ts biome.json components.json",
    "preview": "vite preview",
    "pack:local": "node scripts/pack-local.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@peri-code/rivet": "file:../peri-rivet",
    "@peri-code/sdk": "file:../@peri-sdk",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "5.107.1",
    "@tursodatabase/serverless": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.18",
    "lucide-react": "1.73.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.1",
    "rivetkit": "3.1.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "bun-types": "1.4.4",
    "concurrently": "10.0.7",
    "happy-dom": "21.0.4",
    "peri-sandbox": "file:../peri-sandbox",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "bin": {
    "agent-builder": "./bin/agent-builder.js"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "shared",
    "scripts/rivet-engine-wrapper.sh",
    "docs",
    "README.md",
    ".env.example",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.4.3"
  }
}
