{
  "name": "@peri-code/peri-cf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peri WASM chat on Cloudflare Workers and Durable Objects",
  "scripts": {
    "prepare:wasm": "bun scripts/prepare-wasm.ts",
    "dev": "bun run prepare:wasm && vite",
    "build": "bun run prepare:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests web",
    "smoke:local": "bun run build && bun scripts/smoke.mjs",
    "deploy": "bun run build && wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@peri-code/sdk": "file:../@peri-sdk",
    "@tanstack/react-query": "^5.104.1",
    "hono": "^4.6.0",
    "lib0": "^0.2.119",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0",
    "wrangler": "4.147.0"
  }
}
