{
  "name": "peri-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "tsx scripts/generate-report.ts",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:l0": "node scripts/run-e2e.mjs --tier l0 --no-interactive",
    "e2e:l1": "node scripts/run-e2e.mjs --tier l1 --no-interactive",
    "e2e:l2": "node scripts/run-e2e.mjs --tier l2 --no-interactive",
    "e2e:release": "node scripts/run-e2e.mjs --tier release --no-interactive",
    "e2e:release:strict": "node scripts/run-e2e.mjs --tier release --no-interactive --require-clean-first-pass",
    "e2e:replay:unit": "node --test llm-replay/*.test.mjs",
    "e2e:replay": "node scripts/run-replay-v2.mjs",
    "e2e:replay:record": "node scripts/run-replay-v2.mjs --record",
    "e2e:replay:smoke": "vitest run --config vitest.replay.config.ts",
    "llm:replay": "node llm-replay/cli.mjs",
    "e2e:replay:check": "tsc --noEmit --project tsconfig.replay.json"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.48.0",
    "tui-tester": "file:./tui-tester"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@xterm/headless": "6.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
