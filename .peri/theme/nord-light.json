{
  "name": "nord-light",
  "mode": "light",
  "palette": {
    "base": {
      "bg": "#ECEFF4",
      "fg": "$semantic.text.primary"
    },
    "brand": {
      "primary": "$semantic.accent"
    },
    "gray": {
      "bright": "$semantic.text.primary",
      "muted": "$semantic.text.muted",
      "dim": "$semantic.text.dim",
      "dark": "$semantic.border.dim"
    },
    "accent": {
      "primary": "$semantic.accent"
    },
    "success": {
      "primary": "#587C0C"
    },
    "warning": {
      "primary": "#9C7A00"
    },
    "danger": {
      "primary": "#BF616A"
    },
    "info": {
      "primary": "$semantic.thinking"
    },
    "diff": {
      "add": "#587C0C",
      "remove": "#BF616A",
      "hunk": "#5E81AC",
      "add_bg": "#DCE4CC",
      "remove_bg": "#F0DCDC",
      "add_word_bg": "#C8D4B0",
      "remove_word_bg": "#E8C8C8"
    }
  },
  "semantic": {
    "accent": "#5E81AC",
    "text": {
      "primary": "#5A5F6A",
      "muted": "#616A7C",
      "dim": "#75829C"
    },
    "border": {
      "default": "#8A94A6",
      "active": "$semantic.accent",
      "dim": "#D8DEE9"
    },
    "status": {
      "running": "#9E6B98",
      "success": "#587C0C",
      "warning": "#9C7A00",
      "error": "#BF616A"
    },
    "surface": {
      "default": "#ECEFF4",
      "user": "#D8DEE9",
      "popup": "#FFFFFF",
      "selection": "#C4D3E8",
      "cursor": "#D8DEE9"
    },
    "diff": {
      "add": "#587C0C",
      "remove": "#BF616A",
      "hunk": "#5E81AC",
      "add_bg": "#DCE4CC",
      "remove_bg": "#F0DCDC",
      "add_word_bg": "#C8D4B0",
      "remove_word_bg": "#E8C8C8"
    },
    "loading": "#9E6B98",
    "thinking": "#9E6B98",
    "model_info": "#D08770",
    "bash_border": "#BF616A",
    "selected_fg": "#242A38"
  },
  "component": {
    "message": {
      "user_bg": "#D8DEE9",
      "ai_prefix": "$semantic.text.primary",
      "tool_indicator": "#587C0C",
      "reasoning": "$semantic.thinking"
    },
    "input": {
      "border": "$semantic.text.muted",
      "border_loading": "$semantic.text.muted",
      "cursor_fg": "#ECEFF4",
      "cursor_bg": "#2E3440",
      "prompt": "$semantic.text.muted",
      "prompt_loading": "$semantic.text.muted",
      "continuation": "$semantic.text.dim",
      "placeholder": "$semantic.text.muted"
    },
    "panel": {
      "border": "$semantic.accent",
      "title": "$semantic.text.primary",
      "row_selected": "$semantic.selected_fg",
      "min_height": "8",
      "max_height": "28"
    },
    "popup": {
      "bg": "#FFFFFF",
      "border": "$semantic.thinking",
      "action_primary": "$semantic.accent",
      "selected_fg": "$semantic.selected_fg",
      "modal_max_width": "90",
      "modal_max_height": "28",
      "inline_height": "10"
    },
    "statusbar": {
      "text": "$semantic.text.primary",
      "muted": "$semantic.text.muted",
      "dim": "$semantic.text.dim",
      "mode_accept_edit": "$semantic.thinking",
      "mode_auto": "#9C7A00",
      "mode_bypass": "#BF616A",
      "resource_good": "#587C0C",
      "resource_warn": "#9C7A00",
      "resource_bad": "#BF616A"
    },
    "markdown": {
      "text": "$semantic.text.primary",
      "code": "#BC5B3C",
      "quote": "$semantic.text.muted"
    },
    "scrollbar": {
      "thumb": "$semantic.text.muted",
      "track": "$semantic.text.dim"
    }
  }
}
