# LLM Judge 配置（用于 e2e 测试的 AI 断言）
# 复制此文件为 .env 并填入实际值

# OpenAI 兼容的 API Key（必填）
OPENAI_API_KEY=sk-your-key-here

# API Base URL（可选，默认 https://api.openai.com/v1）
# 如果使用 DeepSeek: https://api.deepseek.com
# 如果使用智谱: https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://api.openai.com/v1

# Judge 使用的模型（可选，默认 gpt-4.1-mini）
# DeepSeek: deepseek-chat
# 智谱: glm-4-flash
JUDGE_MODEL=gpt-4.1-mini
