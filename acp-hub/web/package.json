{
  "name": "acp-hub-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "acp-hub SolidJS Web client and tested UI component library",
  "scripts": {
    "dev": "vite",
    "visual:dev": "vite --host 127.0.0.1",
    "verify:production-boundary": "node scripts/verify-production-boundary.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test tests/*.test.mjs && vitest run && node scripts/verify-production-boundary.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "solid-js": "^1",
    "yjs": "^13"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
